# Copy to .env and fill in whichever provider(s) you end up using.
# Copy to .env and fill in whichever provider(s) you end up using.
# The agent picks a provider based on ORCHESTRATE_MODEL (see config.py).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# For local models via Ollama (litellm talks to it over HTTP)
OLLAMA_API_BASE=http://localhost:11434

# litellm model string, e.g.:
#   claude-sonnet-4-5-20250929   (Anthropic)
#   gemini/gemini-2.5-pro        (Gemini)
#   ollama/llama3.1              (local via Ollama)
#   gpt-4.1                      (OpenAI)
#   openai/<model-name>          (any OpenAI-compatible endpoint -- set ORCHESTRATE_API_BASE/_KEY below)
ORCHESTRATE_MODEL=claude-sonnet-4-5-20250929

# Only needed to point ORCHESTRATE_MODEL=openai/<name> at a non-OpenAI endpoint
# (vLLM, Together, Groq, LM Studio, a custom proxy, etc). Leave blank otherwise.
ORCHESTRATE_API_BASE=
ORCHESTRATE_API_KEY=

# Set to false if the configured model rejects audio input (some do) -- voice rows then
# fall back to context-only reasoning instead of crashing the run.
ORCHESTRATE_SEND_AUDIO_INLINE=true

# Model for code/run_eval.py's rubric-judge pass (see evaluate.py). Deliberately separate
# from ORCHESTRATE_MODEL so grading isn't done by the same model that made the decisions.
# Any litellm-supported provider/endpoint works here (OpenRouter, Hugging Face Inference,
# a local server, etc) -- set ORCHESTRATE_JUDGE_API_KEY to match whichever you use.
# For the default (OpenRouter), leave ORCHESTRATE_JUDGE_API_BASE blank -- litellm resolves
# OpenRouter's endpoint automatically from the "openrouter/" model prefix; only set it if
# you point ORCHESTRATE_JUDGE_MODEL at a non-default/self-hosted endpoint instead.
ORCHESTRATE_JUDGE_MODEL=openrouter/openai/gpt-oss-20b:free
ORCHESTRATE_JUDGE_API_BASE=
ORCHESTRATE_JUDGE_API_KEY=
